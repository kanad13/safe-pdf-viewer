{
	"name": "safe-pdf-viewer",
	"displayName": "Safe PDF Viewer",
	"description": "A focused, read-only PDF viewer for VS Code. Secure by default: PDF JavaScript disabled, no CDN, strict CSP.",
	"version": "1.3.2",
	"icon": "assets/icon.png",
	"publisher": "KunalPathak",
	"author": "Kunal Pathak",
	"homepage": "https://github.com/kanad13/safe-pdf-viewer",
	"bugs": {
		"url": "https://github.com/kanad13/safe-pdf-viewer/issues"
	},
	"engines": {
		"vscode": "^1.105.0",
		"node": ">=22.13.0"
	},
	"categories": [
		"Visualization"
	],
	"keywords": [
		"pdf",
		"viewer",
		"pdf.js",
		"read-only",
		"secure",
		"document"
	],
	"qna": "marketplace",
	"galleryBanner": {
		"color": "#1A237E",
		"theme": "dark"
	},
	"main": "./src/extension.js",
	"activationEvents": [],
	"contributes": {
		"customEditors": [
			{
				"viewType": "safePdfViewer.pdfEditor",
				"displayName": "Safe PDF Viewer",
				"selector": [
					{
						"filenamePattern": "*.pdf"
					}
				],
				"priority": "default"
			}
		],
		"configuration": {
			"title": "Safe PDF Viewer",
			"properties": {
				"safePdfViewer.defaultZoom": {
					"type": "string",
					"default": "fit-page",
					"enum": [
						"fit-page",
						"50",
						"75",
						"100",
						"125",
						"150",
						"200"
					],
					"enumDescriptions": [
						"Fit entire page in viewport",
						"50%",
						"75%",
						"100%",
						"125%",
						"150%",
						"200%"
					],
					"description": "Default zoom level when opening a PDF file."
				}
			}
		}
	},
	"scripts": {
		"lint": "eslint .",
		"test": "node --test 'test/**/*.test.js' && npm run lint && npm run format:check",
		"package": "vsce package",
		"publish": "vsce publish",
		"test:e2e": "playwright test",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.0",
		"@types/node": "^22.20.5",
		"@types/vscode": "1.105.0",
		"@vscode/vsce": "^4.0.0",
		"eslint": "^10.13.0",
		"ovsx": "^1.3.0",
		"prettier": "^3.9.9"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/kanad13/safe-pdf-viewer.git"
	},
	"license": "MIT",
	"pricing": "Free",
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		}
	}
}
