{
	"name": "safe-pdf-viewer",
	"displayName": "Safe PDF Viewer",
	"description": "A focused, read-only PDF viewer for VS Code. Secure by default: PDF JavaScript disabled, no CDN, strict CSP.",
	"version": "0.1.1",
	"icon": "assets/icon.png",
	"publisher": "Kunal Pathak",
	"author": "Kunal Pathak",
	"homepage": "https://github.com/kanad13/safe-pdf-viewer",
	"bugs": {
		"url": "https://github.com/kanad13/safe-pdf-viewer/issues"
	},
	"engines": {
		"vscode": "^1.109.0",
		"node": ">=18.0.0"
	},
	"categories": [
		"Other",
		"Visualization"
	],
	"keywords": [
		"pdf",
		"viewer",
		"pdf.js",
		"read-only",
		"secure",
		"document"
	],
	"qna": "marketplace",
	"galleryBanner": {
		"color": "#1A237E",
		"theme": "dark"
	},
	"main": "./src/extension.js",
	"activationEvents": [],
	"contributes": {
		"customEditors": [
			{
				"viewType": "safePdfViewer.pdfEditor",
				"displayName": "Safe PDF Viewer",
				"selector": [
					{
						"filenamePattern": "*.pdf"
					}
				],
				"priority": "default"
			}
		],
		"configuration": {
			"title": "Safe PDF Viewer",
			"properties": {
				"safePdfViewer.defaultZoom": {
					"type": "string",
					"default": "fit-width",
					"enum": [
						"fit-width",
						"fit-page",
						"50",
						"75",
						"100",
						"125",
						"150",
						"200"
					],
					"enumDescriptions": [
						"Scale to fit the panel width",
						"Scale to fit the full page within the panel",
						"50% zoom",
						"75% zoom",
						"100% actual size",
						"125% zoom",
						"150% zoom",
						"200% zoom"
					],
					"description": "Default zoom level when opening a PDF file."
				}
			}
		}
	},
	"scripts": {
		"lint": "eslint .",
		"test": "node --test 'test/**/*.test.js' && npm run lint",
		"package": "vsce package",
		"publish": "vsce publish"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^25.2.3",
		"@types/vscode": "^1.109.0",
		"@vscode/vsce": "^3.7.1",
		"eslint": "^10.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/kanad13/safe-pdf-viewer.git"
	},
	"license": "MIT",
	"pricing": "Free"
}
