# Allow-list style: everything not needed at run time stays out of the package.
.vscode/**
.github/**
node_modules/**
test/**
docs/**
examples/**
AGENTS.md
WORKPLAN.md
CLAUDE.md
.claude/**
.gitignore
.nvmrc
.prettierignore
.prettierrc.json
eslint.config.js
jsconfig.json
playwright.config.js
**/.DS_Store

# PDF.js source maps are not shipped; only the .mjs bundles are needed.
lib/pdfjs/*.map

playwright-report/**
test-results/**
